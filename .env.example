# Copy to .env.development.local for local development; set the same names in Vercel for production.

# Room relay host, without protocol. Local: 127.0.0.1:8799 (npm run party:dev).
# Production: flowera-rooms.<your-subdomain>.workers.dev (see party/README.md).
NEXT_PUBLIC_PARTY_HOST=127.0.0.1:8799

# Home-GPU transcription gateway (see asr-server/README.md). Leave both empty to always use the
# browser's built-in speech recognition instead.
ASR_GATEWAY_URL=http://127.0.0.1:8787
# Long random string, identical to ASR_TICKET_SECRET in ~/flowera-asr/gateway.env.
# Generate one with: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
ASR_TICKET_SECRET=
